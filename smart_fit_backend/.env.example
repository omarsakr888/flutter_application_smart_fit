# Smart Fit Backend — Environment Variables
# -----------------------------------------
# Copy this file to .env and fill in real values.
# The .env file is listed in .gitignore and must NEVER be committed.
#
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   # or: openssl rand -hex 32
#
# Obtain GEMINI_API_KEY from: https://aistudio.google.com/app/apikey

SECRET_KEY=change_this_in_production

# Only required if the backend calls Gemini directly.
# For the Flutter frontend, pass via --dart-define=GEMINI_API_KEY=<key> instead.
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Web Client ID — enables real Google Sign-In on web.
# Get one free at https://console.cloud.google.com → APIs & Services → Credentials
# Add http://localhost as an Authorized JavaScript Origin.
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Admin panel secret key — set a strong random value in production.
# Passed as the X-Admin-Key header from the Flutter admin screen.
ADMIN_SECRET_KEY=smartfit-admin-2024
